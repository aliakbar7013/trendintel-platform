# 2. Pexels API Key (Free at https://www.pexels.com/api/ when open)
PEXELS_API_KEY=""

# 3. Unsplash Access Key (Free at https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=""

# Hostinger Cron Secret Key for protecting /api/cron/publish
CRON_SECRET="trendintel_cron_secure_token_change_in_production_894172"

# Admin Control Panel Password for /admin
