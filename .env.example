# Database Configuration (Hostinger MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Example: mysql://u123456789_trenduser:SecureMySqlPass123!@127.0.0.1:3306/u123456789_trendintel
DATABASE_URL="mysql://trenduser:trendpass@127.0.0.1:3306/trendintel"

# Google Gemini API Key (Required for AI Synthesis Engine)
# Obtain free from: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# Royalty-Free Editorial Image Providers:
# 1. Pixabay API Key (Instant free key, 5,000 req/hr: https://pixabay.com/api/docs/)
